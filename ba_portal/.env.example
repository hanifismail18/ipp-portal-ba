# BA Portal config. Copy to .env (gitignored). Never commit .env.
HOST=0.0.0.0
PORT=8080
# Engine: chain (default; gemini -> openrouter -> 9router -> claude) | openai | openrouter | claude
ENGINE=chain
# --- LLM chain v3 (ZERO MONEY, ENGINE=chain): gemini -> gemini2 -> openrouter(:free) -> groq -> 9router rotation ---
# Keys: set them in /admin (key manager, encrypted in DB) or here. Empty = layer skipped. Free tiers only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-3.6-flash
GEMINI2_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# daily-call guard per layer (attempts/day; free tiers count failures too)
GEMINI_MAX_CALLS_DAY=400
GEMINI2_MAX_CALLS_DAY=400
OPENROUTER_MAX_CALLS_DAY=45
GROQ_MAX_CALLS_DAY=300
NINEROUTER_MAX_CALLS_DAY=300
# --- 9router (last resort before claude) ---
# --- OpenAI-compatible LLM endpoint ---
# Option A: 9router (local gateway, already has a Gemini provider): key = 9router API key (dashboard http://127.0.0.1:20128)
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=PASTE_9ROUTER_OR_GEMINI_KEY
# comma list = fallback order (used on 503/overload)
LLM_MODEL=gemini/gemini-3.5-flash-lite,gemini/gemini-3-flash-preview,gemini/gemini-3.1-flash-lite-preview,gemini/gemma-4-31b-it,gemini/gemini-3.6-flash,gemini/gemini-3.7-flash,openrouter/google/gemma-4-31b-it:free,openrouter/nvidia/nemotron-3.5-super-vl:free,openrouter/google/gemma-4-26b-a4b-it:free
# Option B: Gemini direct (Boss: paste a key WITH billing from https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=PASTE_GEMINI_API_KEY
# LLM_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite
# --- Fallback chain (ENGINE=chain): LLM_ -> LLM2_ -> claude -p (CLAUDE_FALLBACK=1) ---
# LLM2_ = second OpenAI-compatible endpoint, e.g. OpenRouter. Via 9router (provider "openrouter" already connected there):
# v3: merged into LLM_MODEL rotation
# LLM2_BASE_URL=http://127.0.0.1:20128/v1
# v3: merged into LLM_MODEL rotation
# LLM2_API_KEY=PASTE_9ROUTER_KEY
# v3: merged into LLM_MODEL rotation
# LLM2_MODEL=openrouter/google/gemini-2.5-flash
# or OpenRouter direct (Boss: paste key from https://openrouter.ai/keys, top up credits):
# LLM2_BASE_URL=https://openrouter.ai/api/v1
# LLM2_API_KEY=PASTE_OPENROUTER_API_KEY
# LLM2_MODEL=google/gemini-2.5-flash
LLM_MAX_TOKENS=6000
# claude -p burns the Claude subscription: off in production (v3)
ALLOW_CLAUDE_CLI=0
# --- public links (/f/<token>) ---
PUBLIC_BASE_URL=
RETENTION_DAYS=14
LLM_TIMEOUT=180
LLM_RETRIES=3
CLAUDE_MODEL=sonnet
# --- limits ---
LLM_CONCURRENCY=2
QUOTA_PER_CLIENT_PER_DAY=30
MAX_LLM_CALLS_PER_DAY=500
PAGE_CAP=8
MAX_UPLOAD_MB=20
IMG_MAX_SIDE=1600
IMG_JPEG_QUALITY=80
TRUST_PROXY=0
# --- admin ---
ADMIN_TOKEN=CHANGE_ME
DB_PATH=data/ba_portal.db

# generated on first start if empty
KEY_ENC_SECRET=
